# Copy to .env and enter credentials locally.
ELEVENLABS_API_KEY=
SYNC_API_KEY=

# Optional: Free Hugging Face User Access Token (from https://huggingface.co/settings/tokens)
HF_TOKEN=
HF_LIPSYNC_SPACE=fffiloni/LatentSync

# Leave both blank for bilingual SRTs or supplied translations.
# Required only for automatic translation or detection:
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Optional; imageio-ffmpeg supplies a binary when installed.
FFMPEG_BINARY=
